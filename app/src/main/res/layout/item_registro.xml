<?xml version="1.0" encoding="utf-8"?>
<!-- Declaración del archivo XML como un layout válido -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">
    <!-- Contenedor principal del item.
         Usa orientación vertical para apilar los elementos uno debajo del otro.
         Tiene fondo blanco, padding interno y margen inferior para separar entre items.
         Elevación da un pequeño efecto de sombra. -->

    <TextView
        android:id="@+id/txtResumenDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@android:color/black" />
    <!-- Muestra el resumen de los datos del registro de emergencia.
         Este texto se llena dinámicamente desde el código Kotlin. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">
        <!-- Contenedor para los botones "Eliminar" y "Editar".
             Usa orientación horizontal y alinea los botones al extremo derecho (end). -->

        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eliminar"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/red"
            android:textColor="@android:color/white" />
        <!-- Botón que permite eliminar el registro actual.
             Se resalta en rojo para indicar acción de peligro. -->

        <Button
            android:id="@+id/btnEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/purple_700"
            android:textColor="@android:color/white" />
        <!-- Botón que permite editar el registro.
             Se resalta en violeta (color primario de la app). -->
    </LinearLayout>
</LinearLayout>